_fields":true,"id":"ORC-LXNI5VPYF4","page":6,"quote":"The low Pd samples were annealed for approx. 600 h at temperatures 300 and 400 °C. The time of annealing was selected with respect to previous set of experiments, dealing with this system, where the existence of g-phase was found.[32] The samples were afterwards quenched into the water and structure was prepared by OP-S polishing.","second_reader_agrees":false,"temperature":{"T_K":673.15,"converted_in_code":true,"printed":"300 and 400 °C","unit_basis":"printed_with_value","unit_printed":"°C","value_printed":400.0},"temperature_printed":"300 and 400 °C","temperature_status":"parsed_from_printed","type":"treatment"}],"paper":"doi:10.1002/adem.200500248","reader_tier":"preliminary_flash","readers":["gemini-3.8-flash / exp-context-v2.1-quote","claude-opus-5.5 / exp-context-v2.1-quote (claude broker)"],"section_basis":"own_work_method_cues"},"doi:10.1007/s11664-998-0205-1":{"context_id":"context:source-doi-10-1007-s11664-998-0205-1","items":[{"applies_to":"samples","extraction_accepted":false,"has_dropped_fields":true,"id":"ORC-C47SCTU3JD","page":6,"quote":"After standard metallographic preparation, the samples were analyzed by optical microscopy and the SEM/EPMA technique.","second_reader_agrees":false,"type":"measurement"},{"applies_to":"six different Sn-rich ternary alloys","atmosphere":"dry nitrogen atmosphere","calibration":"pure indium","extraction_accepted":true,"heating_or_cooling_rate":"5°C/min","id":"ORC-EC74OUJWHR","method":"DSC","page":6,"quote":"DSC measurements were made to detect the melting temperature range of six different Sn-rich ternary alloys. The heating and cooling rate used was 5°C/min and the experiments were made under a dry nitrogen atmosphere. A reference run was made with pure indium.","second_reader_agrees":true,"type":"measurement"},{"applies_to":"specimens","extraction_accepted":false,"id":"ORC-HDV6PW3OT5","method":"optical microscopy, SEM, and qualitative energy dispersive spectroscopy